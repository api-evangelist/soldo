{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Transaction VAT Rate API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction VAT Rate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Remove VAT Rate from Transaction ",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/tax-rate",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to remove the `Transaction`'s `VatRate`"
        }
      ]
    }
  ],
  "bundled": true
}
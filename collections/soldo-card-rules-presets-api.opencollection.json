  "items": [
    {
      "info": {
        "name": "Card Rules Presets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Preset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/cards/presets/:presetId",
            "params": [
              {
                "name": "presetId",
                "value": "2d65bd5e-3fdf-4002-b166-bde7fb8863fa",
                "type": "path",
                "description": "The `CardRulePreset` ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to get a `CardRulePreset` by ID."
        },
        {
          "info": {
            "name": "Delete Preset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/cards/presets/:presetId",
            "params": [
              {
                "name": "presetId",
                "value": "2d65bd5e-3fdf-4002-b166-bde7fb8863fa",
                "type": "path",
                "description": "The `CardRulePreset` ID."
              }
            ],
            "auth": {
              "type": "oauth2",

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Accounting Classification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Expense Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/entities/expense-category",
            "params": [
              {
                "name": "text",
                "value": "expense category",
                "type": "query",
                "description": "A simple text to search in the `ExpenseCategory` (`name` or `code`)."
              },
              {
                "name": "enabled",
                "value": "true",
                "type": "query",
                "description": "It determines if `ExpenseCategory` is enabled."
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to find `ExpenseCategories` using filtering parameters."
        }
      ]
    }
  ],
  "bundled": true
}
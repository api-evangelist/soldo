            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.soldo.com/business/v2/wallets/autotransfer-presets/:presetId/relate-resource",
            "headers": [
              {
                "name": "X-Soldo-Fingerprint",
                "value": ""
              },
              {
                "name": "X-Soldo-Fingerprint-Signature",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "presetId",
                "value": "2d65bd5e-3fdf-4002-b166-bde7fb8863fa",
                "type": "path",
                "description": "The `AutoTransferPreset` ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to add a `Wallets` to `AutoTransferPreset`."
        },
        {

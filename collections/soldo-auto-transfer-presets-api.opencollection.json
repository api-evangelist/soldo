          "docs": "Endpoint to delete a `AutoTransferPreset` by ID."
        },
        {
          "info": {
            "name": "Search Auto-transfer Presets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/wallets/autotransfer-presets",
            "params": [
              {
                "name": "type",
                "value": "WHEN_BALANCE_IS",
                "type": "query",
                "description": "The type of `AutoTransferPreset`."
              },
              {
                "name": "currency",
                "value": "",
                "type": "query"
              },
              {
                "name": "text",
                "value": "John Doe",
                "type": "query",
                "description": "The full or partial name of the `AutoTransferPreset`."
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Wallets API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/wallets",
            "params": [
              {
                "name": "type",
                "value": "company",
                "type": "query",
                "description": "The type of resource assigned to the `Wallet`."
              },
              {
                "name": "id",
                "value": "7bf79328-a7ae-4222-aa54-091ff7f429a7",
                "type": "query",
                "description": "The ID of the `type` resource."
              },
              {
                "name": "customreferenceId",
                "value": "123456-user-1",
                "type": "query",
                "description": "The custom reference ID of the `type` resource."
              },
              {
                "name": "groupId",
                "value": "2d65bd5e-3fdf-4002-b166-bde7fb8863fa",
                "type": "query",
                "description": "The ID of the `Group` the `Wallet` is related to."
              },
              {
                "name": "name",
                "value": "John Doe",
                "type": "query",
                "description": "The full or partial name of the `Wallet`."
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to search `Wallets` using filtering parameters."
        },
        {
          "info": {
            "name": "Add Wallet",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/wallets",
            "headers": [
              {
                "name": "X-Soldo-Fingerprint",
                "value": ""
              },
              {
                "name": "X-Soldo-Fingerprint-Signature",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to add a new `Wallet`. Only company wallets can be created, a user dedicated wallet for each currency supported by your account is automatically created by the Soldo platform. *Deprecated*: use [/wallets/create](ref:wallet-create) instead."
        },
        {
          "info": {
            "name": "Create Wallet",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/wallets/create",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to add a new `Wallet`. Only company wallets can be created, a user dedicated wallet for each currency supported by your account is automatically created by the Soldo platform."
        },
        {
          "info": {
            "name": "Make Internal Transfer",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.soldo.com/business/v2/wallets/internalTransfer/:fromWalletId/:toWalletId",
            "headers": [
              {
                "name": "X-Soldo-Fingerprint",
                "value": ""
              },
              {
                "name": "X-Soldo-Fingerprint-Signature",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "fromWalletId",
                "value": "",
                "type": "path"
              },
              {
                "name": "toWalletId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "currencyCode",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to transfer money between two `Wallets` within the same business account."
        },
        {
          "info": {
            "name": "Get Wallet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/wallets/:walletId",
            "params": [
              {
                "name": "walletId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to retrieve a specific `Wallet` by ID."
        },
        {
          "info": {
            "name": "Update Wallet",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.soldo.com/business/v2/wallets/:walletId",
            "params": [
              {
                "name": "walletId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to update a `Wallet`. Only company wallets can be updated, a `User` dedicated wallet for each currency supported by your account is automatically created by the Soldo platform when a `User` gets created."
        },
        {
          "info": {
            "name": "Delete Wallet",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/wallets/:walletId",
            "params": [
              {
                "name": "walletId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to delete the `Wallet`"
        }
      ]
    }
  ],
  "bundled": true
}
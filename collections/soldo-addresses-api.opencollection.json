{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Addresses API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Addresses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Addresses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/addresses",
            "params": [
              {
                "name": "userId",
                "value": "XMPL1234-000001",
                "type": "query",
                "description": "The `User` ID."
              },
              {
                "name": "category",
                "value": "COMPANY",
                "type": "query",
                "description": "The `User` CATEGORY."
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to search `Addresses`."
        },
        {
          "info": {
            "name": "Add Address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/addresses",
            "headers": [
              {
                "name": "X-Soldo-Fingerprint",
                "value": ""
              },
              {
                "name": "X-Soldo-Fingerprint-Signature",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },

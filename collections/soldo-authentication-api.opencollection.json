{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Authentication API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/oauth/authorize",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Grant access to the API getting an `OAuth2Token`."
        },
        {
          "info": {
            "name": "Get who am I",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/ping/whoami",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to get information about the owner of the access token."
        }
      ]
    }
  ],
  "bundled": true
}
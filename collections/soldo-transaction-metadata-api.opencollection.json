{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Transaction Metadata API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Transaction Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/metadata/:metadataId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "metadataId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to get the metadata of a `Transaction` by ID."
        },
        {
          "info": {
            "name": "Add Transaction Metadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/metadata/:metadataId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "metadataId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to add metadata to a `Transaction`."
        },
        {
          "info": {
            "name": "Update Transaction Metadata",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/metadata/:metadataId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "metadataId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to update metadata of a `Transaction`."
        },
        {
          "info": {
            "name": "Delete Transaction Metadata",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/metadata/:metadataId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "metadataId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to delete metadata of a `Transaction`."
        },
        {
          "info": {
            "name": "Search Transaction Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/metadata",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to get the list of metadata of a `Transaction`."
        }
      ]
    }
  ],
  "bundled": true

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Transaction Custom Export API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction Custom Export",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Bulk TransactionCustomExport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/transactions/custom-exports/bulk-add",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint bulk to add a new `TransactionCustomExport`."
        },
        {
          "info": {
            "name": " Remove Bulk TransactionCustomExport",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/transactions/custom-exports/bulk-remove",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint bulk to remove a list of `TransactionCustomExport` by TransactionIds."
        },
        {
          "info": {
            "name": " Retrieve Bulk TransactionCustomExport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/transactions/custom-exports/bulk-retrieve",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint retrieve a list of `TransactionCustomExport` by TransactionIds."
        },
        {
          "info": {
            "name": "Search TransactionCustomExport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soldo.com/business/v2/transactions/custom-exports/search",
            "params": [
              {
                "name": "fromDate",
                "value": "2020-04-06T12:48:40Z",
                "type": "query",
                "description": "The beginning of the period of the search `fromDate` included (i.e. greater than or equal to) (Formats: `yyyy-MM-dd`, `yyyy-MM-ddThh:mm:ss`, `yyyy-MM-ddThh:mm:ssZ`)."
              },
              {
                "name": "toDate",
                "value": "2020-05-07T12:48:40Z",
                "type": "query",
                "description": "The end of the period of the search `toDate` included (i.e. less than) (Formats: `yyyy-MM-dd`, `yyyy-MM-ddThh:mm:ss`, `yyyy-MM-ddThh:mm:ssZ`)."
              },
              {
                "name": "product",
                "value": "SAP",
                "type": "query",
                "description": "A product that exported list of `Transaction`"
              },
              {
                "name": "p",
                "value": "3",
                "type": "query",
                "description": "It indicates the specific page to display (the counter starts from zero)."
              },
              {
                "name": "s",
                "value": "25",
                "type": "query",
                "description": "It indicates the number of items per page."
              },
              {
                "name": "d",
                "value": "DESC",
                "type": "query",
                "description": "It indicates how the pages are ordered."
              },
              {
                "name": "props",
                "value": "creationTime",
                "type": "query",
                "description": "It indicates the sorting direction applied to the above parameters. To apply a sorting on multiple parameters, set as many times the `props` parameter in the request."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to get the list of a `TransactionCustomExport`."
        }
      ]
    }
  ],
  "bundled": true
}
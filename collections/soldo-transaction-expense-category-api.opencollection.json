{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soldo Business API v2.0 Accounting Classification Transaction Expense Category API",
    "version": "5.56.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction Expense Category",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Remove Expense Category from Transaction",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/expense-category",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to remove the `Transaction`'s `ExpenseCategory`"
        },
        {
          "info": {
            "name": "Add Expense Category to Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soldo.com/business/v2/transactions/:transactionId/expense-category/:expenseCategoryId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "expenseCategoryId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.soldo.com/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Endpoint to assign an `ExpenseCategory` to a `Transaction`."
        }
      ]
    }
  ],
  "bundled": true
}